# Shared settings for every screenshot tape (sourced by the others).
# Drawn at twice the size the page shows it, so text stays sharp on HiDPI screens.
Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 30
Set LineHeight 1.15
Set Width 2880
Set Height 1548
Set Padding 36
Set Margin 0
Set WindowBar ""
Set TypingSpeed 15ms
Env BQT_CONFIG "/work/config.vhs.toml"
Env BQT_BIGQUERY_ENDPOINT "http://bqt-shots-emu:9050"
Env TERM "xterm-256color"
Env COLORTERM "truecolor"
